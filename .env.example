# Copy to `.env` and fill in. `.env` is gitignored; this example file is not.

# --- KruMath Supabase project (required) -----------------------------------
# Reuse the existing KruMath project. These two values are public by design:
# they ship inside the browser bundle. Never put the service_role key here.
VITE_SUPABASE_URL=https://diobjtrtyeggymdneyxv.supabase.co
# The legacy `anon` JWT for the KruMath project is disabled, so the publishable key
# is used instead. The session storage key comes from the project ref, not the key,
# so this still reads the same session as krumath.com.
VITE_SUPABASE_ANON_KEY=sb_publishable_-mFp3THPl17L0xiw83Ex6Q_s06s8iGN

# --- KruMath origin (optional) ---------------------------------------------
# Used only for the Home and Pricing links in the toolbar. The sign-in redirect is
# relative, so it does not depend on this.
VITE_KRUMATH_ORIGIN=https://krumath.com

# --- Local development only (optional) -------------------------------------
# Skips the sign-in gate so the UI can be worked on at localhost, which cannot
# hold krumath.com's session cookie. Ignored by production builds because it is
# gated on import.meta.env.DEV. Data features will not work while it is on.
# VITE_AUTH_BYPASS=1
